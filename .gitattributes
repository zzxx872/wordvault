# Normalize line endings so Windows checkouts don't rewrite every file.
* text=auto

*.md      text eol=lf
*.html    text eol=lf
*.js      text eol=lf
*.css     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.py      text eol=lf
*.swift   text eol=lf
*.plist   text eol=lf
*.webmanifest text eol=lf

*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.ipa     binary
*.zip     binary
